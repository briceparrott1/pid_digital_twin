# Anthropic API key — required by both the computer_vision and
# computer_vision_engine_dev apps.
ANTHROPIC_API_KEY=

# Neo4j connection. NEO4J_USER/NEO4J_PASSWORD are also used by
# docker-compose to set up the neo4j container's auth.
# Use bolt://localhost:7687 when running computer_vision outside Docker,
# or bolt://neo4j:7687 when running via docker-compose (already set in
# docker-compose.yaml for the computer-vision service).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Optional overrides — defaults shown are relative to apps/computer_vision/
# SOP_PATH=data/sop/sop.docx
# PID_PATH=data/pid/diagram.pdf
# MODEL=claude-opus-4-5
